 {
+  // ACTUATOR channels are collected into one gz.msgs.Actuators message
+  gz::msgs::Actuators actuatorsMsg;
+  bool haveActuatorCmd = false;
+
   // update velocity PID for controls and apply force to joint
   for (size_t i = 0; i < this->dataPtr->controls.size(); ++i)
   {
+    if (this->dataPtr->controls[i].type == "ACTUATOR")
+    {
+      if (this->dataPtr->haveActuators)
+      {
+        const int idx = this->dataPtr->controls[i].channel;
+        while (actuatorsMsg.velocity_size() <= idx)
+        {
+          actuatorsMsg.add_velocity(0.0);
+        }
+        actuatorsMsg.set_velocity(idx,
+            this->dataPtr->controls[i].outputReady ?
+            this->dataPtr->controls[i].cmd : 0.0);
+        haveActuatorCmd = true;
+      }
+      continue;
+    }
+
     // skip servo output while not ready
     if (!this->dataPtr->controls[i].outputReady)
     {
